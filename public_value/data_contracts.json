{
  "version": "1.0",
  "updated_at": "2026-09-23",
  "purpose": "Machine-readable field registry for CropCircuit local-first operational CSVs and browser workspace collections.",
  "contracts": [
    {
      "id": "observations",
      "label": "Farm observations",
      "workspace_collection": "observation_events",
      "storage_key": "cropcircuit_observation_events_v1",
      "required": [
        "schema_version",
        "event_id",
        "recorded_at",
        "source_kind",
        "domain",
        "summary"
      ],
      "fields": [
        {
          "name": "schema_version",
          "type": "string",
          "const": "0.1"
        },
        {
          "name": "event_id",
          "type": "string"
        },
        {
          "name": "recorded_at",
          "type": "date-time"
        },
        {
          "name": "source_kind",
          "type": "enum",
          "values": [
            "human_observation",
            "sensor_observation",
            "transaction",
            "import",
            "external_source",
            "model_inference"
          ]
        },
        {
          "name": "domain",
          "type": "enum",
          "values": [
            "animal_welfare",
            "livestock",
            "water",
            "infrastructure",
            "safety",
            "pasture",
            "soil",
            "crop",
            "labor",
            "finance",
            "weather",
            "market",
            "other"
          ]
        },
        {
          "name": "signal_key",
          "type": "string",
          "optional": true
        },
        {
          "name": "hypothesis_key",
          "type": "string",
          "optional": true,
          "description": "User-supplied normalized key linking observations that may support the same provisional hypothesis."
        },
        {
          "name": "hypothesis_confidence",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "optional": true,
          "description": "User-supplied confidence that this observation supports the tagged provisional hypothesis."
        },
        {
          "name": "summary",
          "type": "string"
        },
        {
          "name": "value",
          "type": "string_or_number_or_boolean",
          "optional": true
        },
        {
          "name": "unit",
          "type": "string",
          "optional": true
        },
        {
          "name": "severity_hint",
          "type": "enum",
          "values": [
            "normal",
            "watch",
            "urgent",
            "emergency"
          ],
          "optional": true
        },
        {
          "name": "privacy",
          "type": "enum",
          "values": [
            "private",
            "shareable"
          ],
          "optional": true
        }
      ]
    },
    {
      "id": "learning_cycles",
      "label": "Learning cycles",
      "workspace_collection": "learning_cycles",
      "storage_key": "cropcircuit_learning_cycles_v1",
      "schema_ref": "learning_cycle.schema.json",
      "required": [
        "schema_version",
        "cycle_id",
        "created_at",
        "question",
        "prediction",
        "action",
        "stop_rule",
        "provenance",
        "observations",
        "contradictions",
        "updates"
      ],
      "fields": [
        {
          "name": "cycle_id",
          "type": "string"
        },
        {
          "name": "created_at",
          "type": "date-time"
        },
        {
          "name": "question",
          "type": "string"
        },
        {
          "name": "prediction",
          "type": "object",
          "description": "Original statement, confidence, and falsifiers; preserved after outcomes are known."
        },
        {
          "name": "action",
          "type": "object",
          "description": "Action/test, reversibility, optional cost cap, and owner."
        },
        {
          "name": "stop_rule",
          "type": "object"
        },
        {
          "name": "provenance",
          "type": "array"
        },
        {
          "name": "observations",
          "type": "array"
        },
        {
          "name": "contradictions",
          "type": "array"
        },
        {
          "name": "updates",
          "type": "array"
        }
      ]
    },
    {
      "id": "hypothesis_memory",
      "label": "Hypothesis memory",
      "workspace_collection": "hypothesis_memory",
      "storage_key": "cropcircuit_hypothesis_memory_v1",
      "required": [
        "schema_version",
        "memory_id",
        "cycle_id",
        "original_prediction",
        "initial_confidence",
        "current_confidence",
        "disposition"
      ],
      "fields": [
        {
          "name": "memory_id",
          "type": "string"
        },
        {
          "name": "cycle_id",
          "type": "string"
        },
        {
          "name": "created_at",
          "type": "date-time",
          "optional": true
        },
        {
          "name": "updated_at",
          "type": "date-time",
          "optional": true
        },
        {
          "name": "original_prediction",
          "type": "string"
        },
        {
          "name": "initial_confidence",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "name": "current_confidence",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "name": "disposition",
          "type": "enum",
          "values": [
            "active",
            "supported",
            "inconclusive",
            "suspended",
            "rejected"
          ]
        },
        {
          "name": "conditions",
          "type": "array",
          "optional": true
        },
        {
          "name": "tags",
          "type": "array",
          "optional": true
        },
        {
          "name": "reason",
          "type": "string",
          "optional": true
        },
        {
          "name": "outcomes",
          "type": "array",
          "optional": true
        },
        {
          "name": "contradictions",
          "type": "array",
          "optional": true
        },
        {
          "name": "updates",
          "type": "array",
          "optional": true
        },
        {
          "name": "source_refs",
          "type": "array",
          "optional": true
        }
      ]
    },
    {
      "id": "labor",
      "label": "Labor log",
      "workspace_collection": "labor_entries",
      "storage_key": "cropcircuit_farm_labor_log_v1",
      "required": [
        "date",
        "category",
        "task",
        "minutes",
        "workers"
      ],
      "fields": [
        {
          "name": "date",
          "type": "date",
          "description": "Observation date"
        },
        {
          "name": "category",
          "type": "string"
        },
        {
          "name": "task",
          "type": "string"
        },
        {
          "name": "chore_code",
          "type": "string",
          "optional": true
        },
        {
          "name": "minutes",
          "type": "number",
          "minimum": 0
        },
        {
          "name": "workers",
          "type": "number",
          "minimum": 0
        },
        {
          "name": "worker_hours",
          "type": "number",
          "minimum": 0,
          "optional": true,
          "derived": "minutes / 60 * workers"
        },
        {
          "name": "notes",
          "type": "string",
          "optional": true
        }
      ]
    },
    {
      "id": "chore_schedule",
      "label": "Recurring chore schedule",
      "workspace_collection": "chore_schedule",
      "storage_key": "cropcircuit_chore_schedule_v1",
      "required": [
        "task",
        "first_date",
        "frequency",
        "interval",
        "estimated_minutes"
      ],
      "fields": [
        {
          "name": "task",
          "type": "string"
        },
        {
          "name": "chore_code",
          "type": "string",
          "optional": true
        },
        {
          "name": "category",
          "type": "string",
          "optional": true
        },
        {
          "name": "first_date",
          "type": "date"
        },
        {
          "name": "frequency",
          "type": "enum",
          "values": [
            "ONCE",
            "DAILY",
            "WEEKLY",
            "MONTHLY",
            "YEARLY"
          ]
        },
        {
          "name": "interval",
          "type": "integer",
          "minimum": 1
        },
        {
          "name": "estimated_minutes",
          "type": "number",
          "minimum": 0
        },
        {
          "name": "notes",
          "type": "string",
          "optional": true
        }
      ]
    },
    {
      "id": "equipment_maintenance",
      "label": "Equipment maintenance",
      "workspace_collection": "equipment_maintenance",
      "storage_key": "cropcircuit_equipment_maintenance_v1",
      "required": [
        "equipment",
        "service"
      ],
      "fields": [
        {
          "name": "equipment",
          "type": "string"
        },
        {
          "name": "service",
          "type": "string"
        },
        {
          "name": "current_hours",
          "type": "number",
          "minimum": 0,
          "optional": true
        },
        {
          "name": "last_service_hours",
          "type": "number",
          "minimum": 0,
          "optional": true
        },
        {
          "name": "interval_hours",
          "type": "number",
          "minimum": 0,
          "optional": true
        },
        {
          "name": "last_service_date",
          "type": "date",
          "optional": true
        },
        {
          "name": "interval_days",
          "type": "integer",
          "minimum": 0,
          "optional": true
        }
      ]
    },
    {
      "id": "parts_inventory",
      "label": "Equipment parts inventory",
      "workspace_collection": "parts_inventory",
      "storage_key": "cropcircuit_parts_inventory_v1",
      "required": [
        "equipment",
        "part_name"
      ],
      "fields": [
        {
          "name": "equipment",
          "type": "string"
        },
        {
          "name": "part_name",
          "type": "string"
        },
        {
          "name": "primary_part_number",
          "type": "string",
          "optional": true
        },
        {
          "name": "alternate_part_numbers",
          "type": "string",
          "optional": true
        },
        {
          "name": "supplier",
          "type": "string",
          "optional": true
        },
        {
          "name": "storage_location",
          "type": "string",
          "optional": true
        },
        {
          "name": "quantity_on_hand",
          "type": "number",
          "minimum": 0,
          "optional": true
        },
        {
          "name": "reorder_threshold",
          "type": "number",
          "minimum": 0,
          "optional": true
        },
        {
          "name": "preferred_order_quantity",
          "type": "number",
          "minimum": 0,
          "optional": true
        }
      ]
    },
    {
      "id": "harvest",
      "label": "Harvest log",
      "workspace_collection": "harvest_entries",
      "storage_key": "cropcircuit_harvest_log_v1",
      "required": [
        "date",
        "item",
        "quantity",
        "unit"
      ],
      "fields": [
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "item",
          "type": "string"
        },
        {
          "name": "quantity",
          "type": "number",
          "minimum": 0
        },
        {
          "name": "unit",
          "type": "string"
        },
        {
          "name": "destination",
          "type": "string",
          "optional": true
        }
      ]
    },
    {
      "id": "sales",
      "label": "Direct-market sales",
      "workspace_collection": "sales_entries",
      "storage_key": "cropcircuit_sales_log_v1",
      "required": [
        "date",
        "channel",
        "gross_amount"
      ],
      "fields": [
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "channel",
          "type": "string"
        },
        {
          "name": "item",
          "type": "string",
          "optional": true
        },
        {
          "name": "gross_amount",
          "type": "number",
          "minimum": 0
        },
        {
          "name": "payment_fees",
          "type": "number",
          "minimum": 0,
          "optional": true,
          "default": 0
        },
        {
          "name": "refunds_discounts",
          "type": "number",
          "minimum": 0,
          "optional": true,
          "default": 0
        },
        {
          "name": "direct_costs",
          "type": "number",
          "minimum": 0,
          "optional": true,
          "default": 0
        }
      ]
    }
  ]
}
