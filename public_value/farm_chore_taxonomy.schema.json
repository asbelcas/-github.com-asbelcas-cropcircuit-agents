{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/asbelcas/-github.com-asbelcas/cropcircuit-agents/main/public_value/farm_chore_taxonomy.schema.json",
  "title": "CropCircuit Open Farm Chore Taxonomy",
  "type": "object",
  "required": [
    "name",
    "version",
    "updated_at",
    "description",
    "license",
    "categories"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "code",
                "label"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
                },
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
