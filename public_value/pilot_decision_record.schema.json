{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/asbelcas/-github.com-asbelcas-cropcircuit-agents/main/public_value/pilot_decision_record.schema.json",
  "title": "CropCircuit Repeated-Decision Pilot Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "pilot_id",
    "decision_class",
    "created_at",
    "context_tags",
    "governance",
    "predictors",
    "outcome",
    "evaluations",
    "metrics"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "record_id": { "type": "string", "minLength": 1 },
    "pilot_id": { "type": "string", "minLength": 1 },
    "decision_class": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "context_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "hard_constraints"],
      "properties": {
        "gate": { "enum": ["pass", "hold", "reject", "not_run"] },
        "hard_constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": { "type": "string" }
      }
    },
    "predictors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predictor_id", "prediction", "confidence"],
        "properties": {
          "predictor_id": { "type": "string", "minLength": 1 },
          "prediction": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "outcome": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["recorded_at", "description"],
      "properties": {
        "recorded_at": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predictor_id", "relation", "note"],
        "properties": {
          "predictor_id": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["supported", "mixed", "contradicted"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "boolean", "null"]
      }
    }
  }
}
