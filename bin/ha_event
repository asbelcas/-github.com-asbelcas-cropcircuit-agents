#!/usr/bin/env bash
set -euo pipefail

EVENT_TYPE="${1:-cropcircuit_ping}"
shift || true
MSG="${*:-hello from terminal}"
MAX_RETRIES="${HA_RETRY_MAX:-4}"
BASE_DELAY="${HA_RETRY_BASE_SECONDS:-1}"

if [[ -z "${HA_URL:-}" || -z "${HA_TOKEN:-}" ]]; then
  echo "Missing HA_URL or HA_TOKEN. Put them in ~/.bashrc and run: source ~/.bashrc"
  exit 1
fi

normalize_url() {
  local raw="${1%/}"
  if [[ "$raw" =~ ^https?:// ]]; then
    printf '%s\n' "$raw"
  else
    printf 'http://%s\n' "$raw"
  fi
}

check_ha_reachable() {
  local url="$1"
  local try=0
  local delay="$BASE_DELAY"
  while (( try < MAX_RETRIES )); do
    if curl -sS --max-time 4 "$url/api/" >/dev/null 2>&1; then
      return 0
    fi
    ((try+=1))
    sleep "$delay"
    delay=$(( delay * 2 ))
  done
  return 1
}

resolve_ha_url() {
  local primary
  primary="$(normalize_url "$HA_URL")"
  local host
  host="$(printf '%s' "$primary" | sed -E 's#^https?://([^/:]+).*$#\1#')"

  # If URL is local-only, try optional fallbacks first.
  if [[ "$host" == "localhost" || "$host" == "127.0.0.1" || "$host" == "::1" ]]; then
    if [[ -n "${HA_URL_FALLBACKS:-}" ]]; then
      IFS=',' read -r -a fallbacks <<<"${HA_URL_FALLBACKS}"
      for f in "${fallbacks[@]}"; do
        local cand
        cand="$(normalize_url "$f")"
        if check_ha_reachable "$cand"; then
          printf '%s\n' "$cand"
          return 0
        fi
      done
    fi
  fi

  if check_ha_reachable "$primary"; then
    printf '%s\n' "$primary"
    return 0
  fi

  return 1
}

if ! resolved_ha_url="$(resolve_ha_url)"; then
  echo "ERROR: HA unreachable from this runtime (HA_URL=${HA_URL})."
  echo "Set HA_URL to a reachable LAN address (e.g., http://192.168.x.y:8123)."
  echo "Optional: set HA_URL_FALLBACKS='http://192.168.x.y:8123,http://host.docker.internal:8123'"
  exit 2
fi

post_with_backoff() {
  local url="$1"
  local try=0
  local delay="$BASE_DELAY"
  while (( try < MAX_RETRIES )); do
    if curl -sS -X POST \
      -H "Authorization: Bearer ${HA_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{\"source\":\"terminal\",\"msg\":\"${MSG//\"/\\\"}\"}" \
      "${url}/api/events/${EVENT_TYPE}" >/dev/null 2>&1; then
      return 0
    fi
    ((try+=1))
    sleep "$delay"
    delay=$(( delay * 2 ))
  done
  return 1
}

if post_with_backoff "$resolved_ha_url"; then
  echo "OK: event sent to ${resolved_ha_url}/api/events/${EVENT_TYPE}"
else
  echo "ERROR: event post failed after ${MAX_RETRIES} retries to ${resolved_ha_url}"
  exit 3
fi
